{
  "manifest_version": 3,
  "name": "JEV Highlighter",
  "version": "0.1.0",
  "description": "Analyse les marchés visibles sur la page avec JEV et met en évidence les sélections préférées. Un mode Auto optionnel (désactivé par défaut, réservé aux experts) peut placer des paris ; sinon l'extension ne parie jamais.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "src/config.js",
        "src/utils.js",
        "src/storage.js",
        "src/ui-root.js",
        "src/parser.js",
        "src/jev.js",
        "src/context.js",
        "src/matcher.js",
        "src/stake.js",
        "src/highlighter.js",
        "src/picks.js",
        "src/reorder.js",
        "src/stake-ui.js",
        "src/auto/clock.js",
        "src/auto/guard.js",
        "src/auto/scanner.js",
        "src/auto/selector.js",
        "src/auto/readers.js",
        "src/auto/executor.js",
        "src/auto/tracker.js",
        "src/auto/controller.js",
        "src/auto/decisions.js",
        "src/auto/journal.js",
        "src/auto/wiring.js",
        "src/auto/auto-ui.js",
        "src/content.js"
      ],
      "css": [
        "styles/injected.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JEV Highlighter",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/lens.css",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ]
    }
  ]
}
